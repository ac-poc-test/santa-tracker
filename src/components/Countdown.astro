---
// Counts down to midnight at the start of Christmas Eve. The server renders
// it in its own time zone; the browser re-renders it in the viewer's.
function christmasEve(now: Date): Date | null {
  const year = now.getFullYear();
  const eve = new Date(year, 11, 24);
  const boxingDay = new Date(year, 11, 26);
  if (now < eve) return eve;
  if (now < boxingDay) return null;
  return new Date(year + 1, 11, 24);
}

const now = new Date();
const target = christmasEve(now);
const left = target ? target.getTime() - now.getTime() : 0;
const units = [
  ['days', Math.floor(left / 86_400_000)],
  ['hours', Math.floor(left / 3_600_000) % 24],
  ['minutes', Math.floor(left / 60_000) % 60],
  ['seconds', Math.floor(left / 1000) % 60],
] as const;
---

<div class="countdown" role="timer" aria-live="off">
  <svg class="gift" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="4" y="13" width="24" height="16" rx="2" fill="#d62828" />
    <rect x="2" y="9" width="28" height="6" rx="1.5" fill="#e63946" />
    <rect x="14" y="9" width="4" height="20" fill="#ffd54a" />
    <path d="M16 9 C 10 2, 5 6, 9 9 Z M16 9 C 22 2, 27 6, 23 9 Z" fill="#ffd54a" />
  </svg>
  <div class="units" data-active={target ? '' : undefined} hidden={!target}>
    {
      units.map(([name, value]) => (
        <span class="unit">
          <strong data-unit={name}>{String(value).padStart(name === 'days' ? 1 : 2, '0')}</strong>
          <small>{name}</small>
        </span>
      ))
    }
    <span class="until">until Christmas Eve</span>
  </div>
  <span class="tonight" hidden={!!target}>Santa is flying tonight!</span>
</div>

<script>
  function christmasEve(now: Date): Date | null {
    const year = now.getFullYear();
    const eve = new Date(year, 11, 24);
    const boxingDay = new Date(year, 11, 26);
    if (now < eve) return eve;
    if (now < boxingDay) return null;
    return new Date(year + 1, 11, 24);
  }

  const root = document.querySelector<HTMLElement>('.countdown');
  if (root) {
    const unitsEl = root.querySelector<HTMLElement>('.units')!;
    const tonightEl = root.querySelector<HTMLElement>('.tonight')!;
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-unit="${name}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');

    const render = () => {
      const now = new Date();
      const target = christmasEve(now);
      unitsEl.hidden = !target;
      tonightEl.hidden = !!target;
      if (!target) return;
      const left = target.getTime() - now.getTime();
      field('days').textContent = String(Math.floor(left / 86_400_000));
      field('hours').textContent = pad(Math.floor(left / 3_600_000) % 24);
      field('minutes').textContent = pad(Math.floor(left / 60_000) % 60);
      field('seconds').textContent = pad(Math.floor(left / 1000) % 60);
    };

    render();
    setInterval(render, 1000);
  }
</script>

<style>
  .countdown {
    position: absolute;
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 26px 10px 16px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(214, 40, 40, 0.92), rgba(150, 20, 30, 0.92));
    border: 2px solid #ffd54a;
    box-shadow:
      0 0 24px rgba(255, 213, 74, 0.35),
      0 10px 30px rgba(0, 0, 0, 0.4);
    color: #fff;
    white-space: nowrap;
  }
  .gift {
    width: 40px;
    height: 40px;
    flex: none;
    filter: drop-shadow(0 0 2px #fff);
    animation: wiggle 2.4s ease-in-out infinite;
  }
  @keyframes wiggle {
    0%,
    80%,
    100% {
      transform: rotate(0);
    }
    85% {
      transform: rotate(-12deg);
    }
    90% {
      transform: rotate(10deg);
    }
    95% {
      transform: rotate(-6deg);
    }
  }
  .units {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .units[hidden],
  .tonight[hidden] {
    display: none;
  }
  .unit {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .unit strong {
    font-size: 2rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .unit small {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffe9a8;
  }
  .until,
  .tonight {
    font-family: 'Mountains of Christmas', cursive;
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1;
    color: #ffd54a;
    margin-left: 6px;
  }
  @media (max-width: 900px) {
    .countdown {
      top: auto;
      bottom: 16px;
    }
    .unit strong {
      font-size: 1.4rem;
    }
    .until {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gift {
      animation: none;
    }
  }
</style>
